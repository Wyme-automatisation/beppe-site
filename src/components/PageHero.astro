---
/** En-tête des pages intérieures (maquette Hero) */
import Beppe from './Beppe.astro';

interface Props {
  /** Fil d'Ariane, ex. [{ label: 'Accueil', href: '/' }, { label: 'Nos solutions' }] */
  fil: { label: string; href?: string }[];
  surtitre: string;
  titre: string;
  chapo: string;
}
const { fil, surtitre, titre, chapo } = Astro.props;

// Fil d'Ariane en données structurées (identique au fil affiché)
const filLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: fil.map((etape, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: etape.label,
    item: new URL(etape.href ?? Astro.url.pathname, Astro.site).href,
  })),
};
---
<script type="application/ld+json" set:html={JSON.stringify(filLd)} />
<section class="sur-fonce relative w-full overflow-hidden bg-olive text-beige">
  <Beppe
    variante="filigrane-simple"
    width="420"
    height="420"
    class="pointer-events-none absolute -bottom-[70px] -right-[60px] opacity-[0.12]"
  />
  <div class="conteneur relative flex flex-col gap-[18px] pb-20 pt-16">
    <nav aria-label="Fil d'Ariane">
      <ol class="m-0 flex list-none flex-wrap gap-1 p-0 text-sm text-gris-chaud">
        {fil.map((etape, i) => (
          <li class="flex gap-1">
            {i > 0 && <span aria-hidden="true">/</span>}
            {etape.href ? (
              <a href={etape.href} class="text-gris-chaud no-underline hover:text-etincelle">{etape.label}</a>
            ) : (
              <span aria-current="page">{etape.label}</span>
            )}
          </li>
        ))}
      </ol>
    </nav>
    <p class="surtitre text-etincelle">{surtitre}</p>
    <h1 class="m-0 max-w-[860px] font-titre text-[2.5rem] font-bold italic leading-[1.05] text-beige md:text-[3.5rem]">{titre}</h1>
    <p class="m-0 max-w-[680px] text-[1.2rem] leading-[1.55] text-beige-doux">{chapo}</p>
  </div>
</section>
